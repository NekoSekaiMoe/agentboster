# Agent Daemon Configuration Example
# Copy to agentd.toml and edit as needed

[server]
listen = ":18732"
# mTLS certificate paths (use `agentd -gen-certs` to generate)
tls_cert_path = "./certs/server-cert.pem"
tls_key_path = "./certs/server-key.pem"
ca_path = "./certs/ca-cert.pem"
# API key for ClawLess → Daemon callbacks
clawless_api_key = "sk-clawless-xxx"

[clawless]
base_url = "http://localhost:3000"
# mTLS client cert for Daemon → ClawLess API calls
client_cert_path = "./certs/client-cert.pem"
client_key_path = "./certs/client-key.pem"
ca_path = "./certs/ca-cert.pem"
# Heartbeat interval in seconds
heartbeat_interval = 30

[security]
l1_provider = "local_ollama"
l1_endpoint = "http://localhost:11434/api/generate"
l1_model = "tinyllama:latest"
l1_api_key = ""
# Unprivileged user to drop to after root setup (empty = stay root)
run_as_user = ""

[security.l1_threshold]
low = 0.3
medium = 0.7
high = 0.9

[node]
id_file = "/var/run/agentd.node_id"

[sandbox]
default = "tmpfs"
chroot_base = "/var/lib/agentd/chroots"
tmpfs_size = "512m"
docker_socket = "unix:///var/run/docker.sock"

[cache]
path = "/tmp/agentd"
session_max_size = 104857600  # 100MB
sync_interval = "30s"
retry_max_attempts = 5
