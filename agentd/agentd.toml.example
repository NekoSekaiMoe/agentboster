# Agent Daemon Configuration Example
# Copy to agentd.toml and edit as needed
version = "1"

[server]
listen = ":18732"
# mTLS certificate paths (use `agentd -gen-certs` to generate)
tls_cert_path = "./certs/server-cert.pem"
tls_key_path = "./certs/server-key.pem"
ca_path = "./certs/ca-cert.pem"
# API key for ClawLess → Daemon callbacks
clawless_api_key = "sk-clawless-xxx"

[clawless]
base_url = "http://localhost:3000"
# mTLS client cert for Daemon → ClawLess API calls
client_cert_path = "./certs/client-cert.pem"
client_key_path = "./certs/client-key.pem"
ca_path = "./certs/ca-cert.pem"
# Heartbeat interval
heartbeat_interval = "30s"

[security]
l1_enabled = true
fail_open = false
l1_provider = "web_callback"
l1_endpoint = ""
# Optional. Leave empty to use AgentBoster Web Config > Security > L1 scorer model.
l1_model = ""
l1_api_key = ""
# Unprivileged user to drop to after root setup (empty = stay root)
run_as_user = ""

[tools]
# Disabled tool names. Omit or leave empty to enable all tools.
# disabled = ["exec", "exec_batch", "codeact"]
disabled = []

[security.l1_threshold]
low = 0.3
medium = 0.7
high = 0.9

[sandbox]
# Default sandbox type: "docker" (light), "docker-strict", or "lxc" (persistent)
default = "docker"
docker_socket = "unix:///var/run/docker.sock"
# Docker light provider defaults
docker_image = "alpine:edge"
docker_default_cpu = 0.25
docker_default_memory = "256m"
# Docker strict provider defaults (for high-risk/untrusted code)
docker_strict_cpu = 1.0
docker_strict_memory = "512m"
# LXC persistent container defaults
lxc_default_distro = "alpine"
lxc_default_release = "3.21"
lxc_rootfs_base = "/var/lib/agentd/lxc"
# Allowed Docker images for strict provider
allowed_images = ["ubuntu:22.04", "ubuntu:24.04", "alpine:latest", "alpine:edge", "golang:1.22", "node:20", "python:3.12"]
# OS-level enforcement: seccomp + capability drops + mount protection
os_enforce = true
# Custom seccomp profile path (empty = auto-generate from L0 rules)
seccomp_profile_path = ""
# Isolate network namespace by default for docker_light and LXC.
# Set to false for rendered web search/fetch tasks that need sandbox network access.
network_isolate = true

[sandbox.lxc]
# Init commands executed on first LXC container creation.
# web_fetch_rendered/web_search_rendered auto-install Chromium on first use if it is missing.
init_commands = [
    "apk add --no-cache git curl bash ca-certificates",
    "mkdir -p /workspace",
    "echo 'nameserver 8.8.8.8' > /etc/resolv.conf",
]

[cache]
path = "/tmp/agentd"
session_max_size = 104857600  # 100MB
sync_interval = "30s"
retry_max_attempts = 5

[session]
max_count = 50
timeout = "30m"
store_path = "/tmp/agentd/sessions"

[worker]
# Pool sizes (0 = auto based on CPU count)
review_pool_size = 0
sandbox_pool_size = 0
task_pool_size = 0
memory_pool_size = 2
cleanup_pool_size = 1

[worker_pool]
# Dynamic worker pool sizing (from Asika)
# Workers auto-scale based on channel utilization
min_workers = 2
max_workers = 0           # 0 = CPU cores × 4
scale_up_pct = 75         # scale up when utilization ≥ 75%
scale_down_pct = 25       # scale down when utilization ≤ 25%
cooldown_secs = 30        # minimum seconds between scale events
stats_interval = "30s"    # how often to check utilization

# [exec_pool]
# Dedicated pool for the exec_batch tool (parallel command execution).
# Workers auto-scale based on channel utilization.
# min_workers = 2
# max_workers = 0           # 0 = CPU cores × 4
# scale_up_pct = 75         # scale up when utilization ≥ 75%
# scale_down_pct = 25       # scale down when utilization ≤ 25%
# cooldown_secs = 10        # minimum seconds between scale events (faster than worker_pool)
# stats_interval = "5s"     # how often to check utilization (faster than worker_pool)

[task_summary]
auto_update = true
tidy_interval = "168h"
max_decisions = 50

[logging]
level = "info"      # debug, info, warn, error
module = "AgentD"   # module name shown in [brackets]
add_source = true   # show [func.name:line]
