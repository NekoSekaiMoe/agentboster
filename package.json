    "dev": "next dev",
    "format": "biome format . --write",
    "lint:fix": "biome lint . --write --unsafe",
    "postbuild": "tsx scripts/vercel-postbuild.ts",
    "publish": "yarn run check:lint && yarn run build && git push",
