{
  "name": "@agentboster/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "agentboster": "./dist/cli.js"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\" --target=node22 && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.2"
  }
}
