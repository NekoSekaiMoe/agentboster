{
	"name": "agentboster-cli-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"clean": "npm run clean --workspaces",
		"build": "tsgo -p packages/ai/tsconfig.build.json && tsgo -p packages/agent/tsconfig.build.json && tsgo -p packages/agentboster-adapter/tsconfig.build.json && tsgo -p packages/coding-agent/tsconfig.build.json && shx chmod +x packages/coding-agent/dist/cli.js packages/coding-agent/dist/rpc-entry.js && npm run copy-assets --workspace @agentboster-cli/core",
		"bundle": "node scripts/bundle.mjs && shx chmod +x packages/coding-agent/dist/agentboster.cjs",
		"package": "node scripts/package.mjs",
		"check": "biome check --write --error-on-warnings . && tsgo --noEmit",
		"prepare": "husky"
	},
	"devDependencies": {
		"@anthropic-ai/sandbox-runtime": "0.0.26",
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"esbuild": "0.28.1",
		"husky": "9.1.7",
		"jiti": "2.7.0",
		"shx": "0.4.0",
		"tsx": "4.22.1",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"version": "0.1.0",
	"overrides": {
		"rimraf": "6.1.2",
		"gaxios": {
			"rimraf": "6.1.2"
		}
	},
	"allowScripts": {
		"esbuild@0.28.1": true
	}
}
