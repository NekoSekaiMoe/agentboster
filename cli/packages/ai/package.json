{
	"name": "@agentboster-cli/ai",
	"version": "0.1.0",
	"description": "LLM API type surface and event-stream primitives for the agentboster CLI (thin-client fork of pi-ai).",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./compat": {
			"types": "./src/compat.ts",
			"import": "./src/compat.ts"
		},
		"./utils/*": {
			"types": "./src/utils/*.ts",
			"import": "./src/utils/*.ts"
		}
	},
	"files": [
		"src",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"typebox": "1.1.38"
	},
	"keywords": [
		"ai",
		"llm",
		"unified",
		"api"
	],
	"author": "AgentBoster",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/anomalyco/agentboster.git",
		"directory": "cli/packages/ai"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "24.12.4",
		"vitest": "4.1.9"
	}
}
