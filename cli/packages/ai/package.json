{
	"name": "@earendil-works/pi-ai",
	"version": "0.80.2",
	"description": "Unified LLM API with automatic model discovery and provider configuration",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": [
		"./dist/compat.js"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./compat": {
			"types": "./src/compat.ts",
			"import": "./src/compat.ts"
		},
		"./utils/*": {
			"types": "./src/utils/*.ts",
			"import": "./src/utils/*.ts"
		}
	},
	"files": [
		"src",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"typebox": "1.1.38"
	},
	"keywords": [
		"ai",
		"llm",
		"unified",
		"api"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/earendil-works/pi.git",
		"directory": "packages/ai"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "24.12.4",
		"vitest": "4.1.9"
	}
}
