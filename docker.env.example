# Copy this file to docker.env before building the Docker image.
# Dockerfile copies docker.env to .env so Next.js can load it automatically.
# Do not commit docker.env or publish images built with real secrets.

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Public URL used to generate bot/webhook callback URLs.
# The current code reads the Vercel production URL variable for this.
NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL=http://localhost:3000

# Required auth/session secret. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-random-secret

# Database used by the web app and graphile-worker.
DATABASE_URL=postgresql://agentboster_user:your_secure_password@postgres:5432/agentboster

# Required for self-hosted Workflow.
WORKFLOW_TARGET_WORLD=@workflow/world-postgres

# Standard Redis URL used by chat adapter state.
REDIS_URL=redis://:your_redis_password@redis:6379

# Upstash Redis REST credentials, or an Upstash-compatible REST proxy.
# A plain redis:// URL does not work for these two variables.
KV_REST_API_URL=https://your-upstash-redis.upstash.io
KV_REST_API_TOKEN=your_upstash_token

# Currently needed for attachment and skill import/export features.
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token

# Initial admin user created when the users table is empty.
USERNAME=admin
PASSWORD=change-me

# Configure at least one model provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
DEEPSEEK_API_KEY=

# Optional: required only if you deploy agentd.
AGENTD_API_KEY=
