# Copy this file to docker.env before building the Docker image.
# Dockerfile copies docker.env to .env so Next.js can load it automatically.
# Do not commit docker.env or publish images built with real secrets.
#
# This is the SELF-HOSTED profile. The app auto-detects self-hosted vs Vercel
# from the environment (no VERCEL / VERCEL_DEPLOYMENT_ID set => self-hosted),
# and swaps backends accordingly:
#   - Database : plain Postgres over TCP via node-postgres (not Neon HTTP)
#   - KV        : Postgres-backed tables (kv_store / kv_sets), NOT Upstash
#   - Blob      : S3 / MinIO, served through the signed /api/blob proxy route

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Public origin of this app, used to generate bot/webhook callback URLs and the
# signed /api/blob proxy URLs handed to LLM providers. Must be reachable by the
# LLM/IM platforms you use. Behind a reverse proxy, set this to the external
# HTTPS origin (e.g. https://agentboster.example.com).
PUBLIC_APP_URL=http://localhost:3000

# Required auth/session secret. Generate with: openssl rand -base64 32
# Also keys the /api/blob and /api/l2 signed-URL HMACs.
AUTH_SECRET=replace-with-random-secret

# Plain Postgres over TCP. The app selects the node-postgres driver for any
# non-neon.tech host automatically; force it with DB_DRIVER=postgres if needed.
# pgvector must be available (the migration runs CREATE EXTENSION vector).
DATABASE_URL=postgresql://agentboster_user:your_secure_password@postgres:5432/agentboster
# Optional driver override: 'postgres' (TCP) or 'neon' (HTTP). Auto-detected
# from the URL host when unset.
# DB_DRIVER=postgres

# Workflow durable-execution backend. Off Vercel the DevKit defaults to the
# filesystem-backed 'local' world (persisted under the Next.js server's working
# dir). Leave as 'local' unless you have a custom world package installed.
WORKFLOW_TARGET_WORLD=local

# Chat-adapter session state store — a standard redis:// URL (TCP). This is
# separate from the KV layer above and is unchanged between Vercel/self-hosted.
REDIS_URL=redis://:your_redis_password@redis:6379

# Upstash Redis REST credentials — NOT used when self-hosted (KV is Postgres-
# backed). Leave blank/unset here. They are only read on Vercel deployments.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ── Blob storage (S3 / MinIO) ────────────────────────────────────────────────
# Object storage for chat attachments and skill import/export. Files are served
# to the browser/LLM through the signed /api/blob/<key>?t=&s= proxy route, so
# the bucket does NOT need to be public. BLOB_READ_WRITE_TOKEN (Vercel Blob) is
# not used when self-hosted.
S3_BUCKET=agentboster
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key
# For MinIO / non-AWS S3, set the endpoint (path-style addressing is enabled
# automatically when S3_ENDPOINT is set). Omit for real AWS S3.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true

# Initial admin user created when the users table is empty.
USERNAME=admin
PASSWORD=change-me

# Configure at least one model provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
DEEPSEEK_API_KEY=

# Optional: required only if you deploy agentd (the sandboxed execution plane).
# Without it, code-execution tools fall back to (limited) in-process behavior.
AGENTD_API_KEY=
# AGENTD_URL=https://your-agentd-host:port
