{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"paths": {
			"*": ["./*"],
			"@agentboster-cli/ai": ["./packages/ai/src/index.ts"],
			"@agentboster-cli/ai/*": ["./packages/ai/src/*.ts"],
			"@agentboster-cli/ai/dist/*": ["./packages/ai/src/*"],
			"@agentboster-cli/agent": ["./packages/agent/src/index.ts"],
			"@agentboster-cli/agent/*": ["./packages/agent/src/*"],
			"@agentboster-cli/core": ["./packages/coding-agent/src/index.ts"],
			"@agentboster-cli/core/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@agentboster-cli/core/*": ["./packages/coding-agent/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@agentboster-cli/tui": ["./node_modules/@agentboster-cli/tui/dist/index.d.ts"],
			"@agentboster-cli/tui/*": ["./node_modules/@agentboster-cli/tui/dist/*"],
			"@agentboster/adapter": ["./packages/agentboster-adapter/src/index.ts"],
			"@agentboster/adapter/*": ["./packages/agentboster-adapter/src/*.ts"]
		}
	},
	"include": ["packages/*/src/**/*", "packages/*/test/**/*", "packages/coding-agent/examples/**/*"],
	"exclude": ["**/dist/**", "packages/coding-agent/examples/extensions/gondolin/**"]
}
