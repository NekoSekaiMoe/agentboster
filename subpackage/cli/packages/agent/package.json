{
	"name": "@agentboster-cli/agent",
	"version": "0.1.0",
	"description": "Agent loop primitives for the agentboster CLI (thin-client fork of pi-agent-core).",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run --passWithNoTests",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@agentboster-cli/ai": "^0.1.0",
		"typebox": "1.1.38"
	},
	"keywords": [
		"ai",
		"agent",
		"llm",
		"transport",
		"state-management"
	],
	"author": "AgentBoster",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/anomalyco/agentboster.git",
		"directory": "cli/packages/agent"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "24.12.4",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	}
}
