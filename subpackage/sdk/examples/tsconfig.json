{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "baseUrl": ".",
    "paths": {
      "@agentboster/sdk": ["../src/index.ts"],
      "@agentboster-cli/core": ["../vendor/core.d.ts"],
      "typebox": ["../vendor/typebox.d.ts"]
    }
  },
  "include": ["**/*.ts", "../vendor/**/*.d.ts"]
}
