# Agent Daemon Configuration Example
# Copy to agentd.toml and edit as needed
#
# Runtime singleton locks (hardcoded paths, not configurable):
#   /var/run/agentd/agentd.sock  — unix socket lock (primary mutex, OS-atomic)
#   /var/run/agentd/agentd.pid   — pid file (fallback for stale-socket cleanup)
# The lock dir /var/run/agentd/ is chowned to [security].run_as_user before the
# privilege drop so the dropped-to user can unlink these files on shutdown.
# The daemon refuses to start if another instance holds either. On a
# crash (kill -9 / OOM / power loss) the next launch detects leftover
# artifacts via the pid file's liveness probe and cleans them up.
# Additionally, server.listen is probed at startup as a backstop.
version = "1"

[server]
listen = ":18732"
# mTLS certificate paths (use `agentd -gen-certs` to generate)
tls_cert_path = "./certs/server-cert.pem"
tls_key_path = "./certs/server-key.pem"
ca_path = "./certs/ca-cert.pem"
# API key for ClawLess → Daemon callbacks
clawless_api_key = "sk-clawless-xxx"
# Concurrency + timeout for /api/v1 requests (non-streaming).
# max_concurrent_requests caps in-flight requests (503 on overflow); 0 = unlimited.
# request_timeout caps each request's context (streaming endpoints are exempt).
max_concurrent_requests = 64
request_timeout = "10m"

[clawless]
base_url = "http://localhost:3000"
# mTLS client cert for Daemon → ClawLess API calls
client_cert_path = "./certs/client-cert.pem"
client_key_path = "./certs/client-key.pem"
ca_path = "./certs/ca-cert.pem"
# Heartbeat interval
heartbeat_interval = "30s"

[security]
l1_enabled = true
fail_open = false
l1_provider = "web_callback"
l1_endpoint = ""
# Optional. Leave empty to use AgentBoster Web Config > Security > L1 scorer model.
l1_model = ""
l1_api_key = ""
# Unprivileged user to drop to after root setup (empty = stay root)
run_as_user = ""

[tools]
# Disabled tool names. Omit or leave empty to enable all tools.
# disabled = ["exec", "exec_batch", "codeact"]
disabled = []

[security.l1_threshold]
low = 0.3
medium = 0.7
high = 0.9

[sandbox]
# Default sandbox type: "docker" (light), "docker-strict", or "lxc" (persistent)
default = "docker"
# Admission control (M3.1). 0 = unlimited (legacy behavior).
# max_persistent_sandboxes caps how many long-lived LXC workspace containers
# can coexist; max_ephemeral_sandboxes caps concurrently-live short-lived
# docker sandboxes. mem_reserve_mb rejects new persistent containers when
# host free memory drops below this reserve.
max_persistent_sandboxes = 20
max_ephemeral_sandboxes = 50
mem_reserve_mb = 512
# Prefer rootless Docker and use the matching [security].run_as_user.
docker_socket = "unix:///run/user/1001/docker.sock"
# Rootful Docker's /var/run/docker.sock is root-equivalent. To use it anyway,
# set docker_socket = "unix:///var/run/docker.sock" and explicitly opt in:
allow_rootful_docker = false
# Docker light provider defaults
docker_image = "alpine:edge"
docker_default_cpu = 0.25
docker_default_memory = "256m"
# Docker strict provider defaults (for high-risk/untrusted code)
docker_strict_cpu = 1.0
docker_strict_memory = "512m"
# LXC persistent container defaults
lxc_default_distro = "alpine"
lxc_default_release = "3.21"
lxc_rootfs_base = "/var/lib/agentd/lxc"
# Allowed Docker images for strict provider
allowed_images = ["ubuntu:22.04", "ubuntu:24.04", "alpine:latest", "alpine:edge", "golang:1.22", "node:20", "python:3.12"]
# OS-level enforcement: seccomp + capability drops + mount protection
os_enforce = true
# Custom seccomp profile path (empty = auto-generate from L0 rules)
seccomp_profile_path = ""
# Isolate network namespace by default for docker_light and LXC.
# Set to false for rendered web search/fetch tasks that need sandbox network access.
network_isolate = true

[sandbox.lxc]
# Init commands executed on first LXC container creation.
# web_fetch_rendered/web_search_rendered auto-install Chromium on first use if it is missing.
#
# The defaults below are tuned for alpine (the default distro). If you
# set lxc_default_distro to ubuntu/debian/etc., `apk` won't exist and
# the first command will fail (logged at WARN, not fatal); replace it
# with the matching command:
#   - ubuntu/debian: "apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends git curl bash ca-certificates xz-utils"
#   - RHEL/Fedora:   "dnf install -y git curl bash ca-certificates xz"
#
# The resolv.conf line is gated on `command -v apk` so it only fires on
# alpine (where stock images sometimes ship with an empty resolv.conf).
# On systemd-resolved distros /etc/resolv.conf is a daemon-managed
# symlink and overwriting it breaks DNS — the apk guard skips them.
#
# As a safety net, the browser bridge's node_install.sh runs a tool
# preflight on every invocation and emits an AGENTD_NODE_INSTALL_HINT
# line with the exact install command for the detected package manager,
# so the LLM can self-recover even if these init_commands are wrong.
init_commands = [
    "apk add --no-cache git curl bash ca-certificates xz",
    "mkdir -p /workspace",
    "command -v apk >/dev/null 2>&1 && [ ! -s /etc/resolv.conf ] && echo 'nameserver 8.8.8.8' > /etc/resolv.conf || true",
]

# ── Optional: GUI-enabled profile for desktop app debugging ──────────────
# Uncomment the block below (replacing the init_commands above) to bake a
# minimal X11 desktop into every new LXC sandbox. The stack is:
#   - Xvfb (headless X server on :99)
#   - icewm (10MB window manager, no GTK/Qt deps)
#   - x11vnc (VNC server attached to :99, RFB port 5999)
#   - websockify + noVNC (HTTP on port 6080, open /vnc.html in a browser)
#   - xdotool (mouse/keyboard injection)
#   - imagemagick (for the desktop_screenshot tool — lossless X11 capture)
#
# The desktop_screenshot tool auto-provisions all of this on first call
# via desktop_install.sh (idempotent + LLM-self-heal hints), so you do
# NOT need to enable this profile unless you want every sandbox to come
# up with the stack preinstalled (saves the ~30s cold-start on first
# desktop_screenshot call).
#
# Requires lxc_default_distro = "alpine" (the default) for the package
# names below to resolve. On debian/ubuntu, replace `apk add --no-cache`
# with `apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends`
# and use the debian package names (xvfb icewm x11vnc websockify novnc
# xdotool imagemagick fonts-noto-cjk).
#
# Once a sandbox is up, expose the noVNC port to the user with the
# sandbox.public_port tool and share the returned URL with path /vnc.html.
#
# init_commands = [
#     "apk add --no-cache git curl bash ca-certificates xz",
#     "mkdir -p /workspace",
#     "command -v apk >/dev/null 2>&1 && [ ! -s /etc/resolv.conf ] && echo 'nameserver 8.8.8.8' > /etc/resolv.conf || true",
#     # GUI stack (Alpine community repo required for icewm / x11vnc)
#     "grep -q community /etc/apk/repositories || (echo \"$(head -n1 /etc/apk/repositories | sed 's#/main#/community#')\") >> /etc/apk/repositories",
#     "apk add --no-cache xorg-server-xvfb icewm x11vnc websockify novnc xdotool imagemagick",
# ]

[cache]
path = "/tmp/agentd"
session_max_size = 104857600  # 100MB
sync_interval = "30s"
retry_max_attempts = 5

[session]
max_count = 50
timeout = "30m"
store_path = "/tmp/agentd/sessions"

[worker]
# Pool sizes (0 = auto based on CPU count)
review_pool_size = 0
sandbox_pool_size = 0
task_pool_size = 0
memory_pool_size = 2
cleanup_pool_size = 1

[worker_pool]
# Dynamic worker pool sizing (from Asika)
# Workers auto-scale based on channel utilization
min_workers = 2
max_workers = 0           # 0 = CPU cores × 4
scale_up_pct = 75         # scale up when utilization ≥ 75%
scale_down_pct = 25       # scale down when utilization ≤ 25%
cooldown_secs = 30        # minimum seconds between scale events
stats_interval = "30s"    # how often to check utilization

# [exec_pool]
# Dedicated pool for the exec_batch tool (parallel command execution).
# Workers auto-scale based on channel utilization.
# min_workers = 2
# max_workers = 0           # 0 = CPU cores × 4
# scale_up_pct = 75         # scale up when utilization ≥ 75%
# scale_down_pct = 25       # scale down when utilization ≤ 25%
# cooldown_secs = 10        # minimum seconds between scale events (faster than worker_pool)
# stats_interval = "5s"     # how often to check utilization (faster than worker_pool)

[task_summary]
auto_update = true
tidy_interval = "168h"
max_decisions = 50

[logging]
level = "info"      # debug, info, warn, error
module = "AgentD"   # module name shown in [brackets]
add_source = true   # show [func.name:line]

# [advisor]
# Advisor model for the advisor-strategy pattern. When configured, the
# agent can escalate to a stronger model for guidance mid-task.
# model = "claude-sonnet-4-20250514"  # model ID sent to the provider
# api_key = ""                         # provider API key (or $ENV_VAR)
# base_url = ""                        # provider base URL override
# effort = ""                          # thinking level: low, medium, high, xhigh

# [checkpoint]
# Automatic git-based checkpoints in the sandbox workspace.
# auto = false                         # create checkpoint after each turn
# max_per_session = 50                 # max checkpoints before auto-pruning
